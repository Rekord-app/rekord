[Unit]
Description=Focus Recorder private upload and video sharing
After=network.target

[Service]
Type=simple
User=focus-share
Group=focus-share
WorkingDirectory=/opt/focus-share/current
EnvironmentFile=/etc/focus-share.env
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/focus-share
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=384M
TasksMax=64

[Install]
WantedBy=multi-user.target
